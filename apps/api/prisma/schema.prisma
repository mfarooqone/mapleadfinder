generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProviderType {
  WAHA
  BAILEYS
  META_CLOUD
  TWILIO
  DIALOG360
  MESSAGEBIRD
}

enum LeadStatus {
  NEW
  INTERESTED
  QUALIFIED
  CLOSED
  LOST
}

enum TemplateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum TemplateChannel {
  WHATSAPP
  EMAIL
}

enum ConversationStatus {
  OPEN
  REPLIED
  INTERESTED
  CLOSED
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum JobType {
  SEND_WHATSAPP
  SEND_EMAIL
  AI_REPLY
  FOLLOW_UP
  TEMPLATE_SYNC
}

enum JobStatus {
  PENDING
  PROCESSING
  PAUSED
  DONE
  FAILED
}

enum EmailFolder {
  INBOX
  SENT
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailAiProvider {
  OPENAI
  MISTRAL
}

enum UserRole {
  ADMIN
  USER
}

enum WarmUpStatus {
  PENDING
  LINK_SENT
  ENGAGED
  BLOCKED
}

enum LeadSource {
  MANUAL
  CSV
  GOOGLE_MAPS
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String?
  passwordHash     String
  role             UserRole  @default(USER)
  isActive         Boolean   @default(true)
  emailVerifiedAt  DateTime?
  licenseExpiresAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([role, isActive])
  @@index([emailVerifiedAt])
  @@index([licenseExpiresAt])
}

model SignupVerification {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

model PasswordResetVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model WhatsAppAccount {
  id                 String       @id @default(uuid())
  userId             String
  phoneNumber        String       @unique
  provider           ProviderType
  apiKey             String
  apiSecret          String?
  businessAccountId  String?
  webhookVerifyToken String?
  webhookUrl         String?
  isActive           Boolean      @default(true)
  metadata           Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  templates          Template[]
  conversations      Conversation[]
  messages           Message[]

  @@unique([userId])
  @@index([userId, provider])
}

model Lead {
  id            String           @id @default(uuid())
  userId        String
  name          String?
  category      String?
  address       String?
  phone         String?
  email         String?
  website       String?
  rating        Float?
  reviewsCount  Int?
  source        LeadSource       @default(MANUAL)
  sourceKeyword String?
  optIn         Boolean          @default(false)
  warmUpStatus  WarmUpStatus     @default(PENDING)
  firstIncomingAt DateTime?
  lastOutgoingAt  DateTime?
  status        LeadStatus       @default(NEW)
  tags          String[]         @default([])
  qualityScore  Int              @default(0)
  qualityReasons String[]        @default([])
  emailDeliveryStatus String     @default("UNKNOWN")
  emailLastSentAt DateTime?
  emailLastReplyAt DateTime?
  emailLastBounceAt DateTime?
  emailLastError String?
  metadata      Json?
  isDeleted     Boolean          @default(false)
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  conversations Conversation[]
  jobs          Job[]
  scrapeBatches ScrapeBatchLead[]
  decisionMakers LeadDecisionMaker[]

  @@unique([userId, phone])
  @@index([userId, status])
  @@index([userId, isDeleted])
  @@index([userId, source])
  @@index([rating])
  @@index([email])
  @@index([website])
  @@index([userId, qualityScore])
  @@index([userId, emailDeliveryStatus])
}

model LeadDecisionMaker {
  id          String   @id @default(uuid())
  userId      String
  leadId      String
  name        String?
  title       String?
  email       String?
  emailType   String   @default("UNKNOWN")
  confidence  Int      @default(0)
  sourceUrl   String?
  sourceText  String?
  isBest      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, leadId])
  @@index([userId, isBest])
  @@index([email])
}

model EmailCampaign {
  id                       String   @id @default(uuid())
  userId                   String
  name                     String?
  subjectTemplate          String
  bodyTemplatePreview      String?
  aiPersonalizationEnabled Boolean  @default(false)
  provider                 EmailAiProvider?
  status                   String   @default("QUEUED")
  totalSelected            Int      @default(0)
  queued                   Int      @default(0)
  sent                     Int      @default(0)
  failed                   Int      @default(0)
  skippedNoEmail           Int      @default(0)
  skippedInvalidEmail      Int      @default(0)
  replied                  Int      @default(0)
  bounced                  Int      @default(0)
  startedAt                DateTime @default(now())
  completedAt              DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status])
}

model ScrapeBatch {
  id          String            @id @default(uuid())
  userId      String
  keyword     String
  maxRecords  Int?
  discovered  Int               @default(0)
  saved       Int               @default(0)
  isDeleted   Boolean           @default(false)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  leads       ScrapeBatchLead[]

  @@index([userId, isDeleted, createdAt])
  @@index([userId, keyword])
}

model ScrapeBatchLead {
  scrapeBatchId String
  leadId        String
  createdAt     DateTime    @default(now())
  scrapeBatch   ScrapeBatch @relation(fields: [scrapeBatchId], references: [id], onDelete: Cascade)
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@id([scrapeBatchId, leadId])
  @@index([leadId])
}

model Template {
  id                String           @id @default(uuid())
  userId            String
  whatsappAccountId String?
  channel           TemplateChannel  @default(WHATSAPP)
  name              String
  subject           String?
  content           String
  language          String           @default("en_US")
  category          String           @default("MARKETING")
  variables         Json?
  status            TemplateStatus   @default(DRAFT)
  externalTemplateId String?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  whatsappAccount   WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  messages          Message[]

  @@unique([userId, name])
  @@index([userId, status])
  @@index([userId, channel])
}

model EmailSmtpSettings {
  id              String   @id @default(uuid())
  userId          String   @unique
  host            String
  port            Int      @default(587)
  secure          Boolean  @default(false)
  username        String?
  password        String?
  fromEmail       String
  fromName        String?
  replyToEmail    String?
  isActive        Boolean  @default(true)
  lastVerifiedAt  DateTime?
  lastVerifyError String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, isActive])
}

model EmailAiSettings {
  id              String          @id @default(uuid())
  userId          String          @unique
  provider        EmailAiProvider @default(OPENAI)
  apiKey          String?
  openaiApiKey    String?
  mistralApiKey   String?
  isActive        Boolean         @default(true)
  lastTestedAt    DateTime?
  lastTestError   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, isActive])
  @@index([provider])
}

model EmailMailboxSettings {
  id              String   @id @default(uuid())
  userId          String   @unique
  imapHost        String
  imapPort        Int      @default(993)
  imapSecure      Boolean  @default(true)
  imapUsername    String
  imapPassword    String?
  inboxFolder     String   @default("INBOX")
  sentFolder      String   @default("Sent")
  isActive        Boolean  @default(true)
  lastSyncedAt    DateTime?
  lastSyncError   String?
  lastVerifiedAt  DateTime?
  lastVerifyError String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, isActive])
}

model EmailMessage {
  id           String         @id @default(uuid())
  userId       String
  leadId       String?
  folder       EmailFolder
  direction    EmailDirection
  imapFolder   String
  imapUid      Int
  messageId    String?
  threadKey    String?
  fromEmail    String?
  fromName     String?
  toEmails     String[]       @default([])
  ccEmails     String[]       @default([])
  subject      String?
  preview      String?
  textBody     String?
  htmlBody     String?
  bodyCachedAt DateTime?
  sentAt       DateTime?
  receivedAt   DateTime?
  isRead       Boolean        @default(false)
  rawHeaders   Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([userId, imapFolder, imapUid])
  @@index([userId, folder, receivedAt])
  @@index([userId, folder, sentAt])
  @@index([userId, isRead])
  @@index([userId, leadId])
  @@index([messageId])
}

model Conversation {
  id             String             @id @default(uuid())
  userId         String
  leadId         String?
  whatsappAccountId String?
  phone          String
  status         ConversationStatus @default(OPEN)
  lastIncomingAt DateTime?
  lastOutgoingAt DateTime?
  lastMessageAt  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  lead           Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  whatsappAccount WhatsAppAccount?  @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  messages       Message[]
  jobs           Job[]

  @@unique([userId, phone])
  @@unique([userId, whatsappAccountId, phone])
  @@index([userId, lastMessageAt])
  @@index([userId, whatsappAccountId, lastMessageAt])
}

model Message {
  id                String           @id @default(uuid())
  conversationId    String
  whatsappAccountId String?
  templateId        String?
  phone             String
  content           String
  direction         MessageDirection
  status            MessageStatus
  providerMessageId String?
  provider          ProviderType?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  whatsappAccount   WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  template          Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([phone, createdAt])
  @@index([providerMessageId])
}

model Job {
  id          String    @id @default(uuid())
  userId      String
  conversationId String?
  leadId      String?
  type        JobType
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([status, runAt])
  @@index([userId, type])
}

model OutreachDailyStats {
  id                String   @id @default(uuid())
  userId            String
  whatsappAccountId String
  date              DateTime @db.Date
  coldSendCount     Int      @default(0)
  newContactCount   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([whatsappAccountId, date])
  @@index([userId, date])
}
